{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026-x64-d",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "C:/Program Files/Microsoft Visual Studio/18/Insiders",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-gcc-x64",
      "displayName": "Linux GCC x64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-gcc-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-x64-debug",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-x64-release",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-x64-release",
      "configurePreset": "linux-gcc-x64"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs2026-x64-debug",
      "configurePreset": "windows-vs2026-x64",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 60
      }
    },
    {
      "name": "windows-vs2026-x64-release",
      "configurePreset": "windows-vs2026-x64",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 60
      }
    },
    {
      "name": "linux-gcc-x64-release",
      "configurePreset": "linux-gcc-x64",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 60
      }
    }
  ]
}
